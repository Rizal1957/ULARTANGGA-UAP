    // ============================================================
    // MODEL: Board
    // ============================================================
 
    static class Board {
        Map<Integer, Integer> snakes  = new LinkedHashMap<>();
        Map<Integer, Integer> ladders = new LinkedHashMap<>();
        Cell[][] grid = new Cell[10][10];
 
        public Board(boolean useCustom) {
            createBoard();
            if (useCustom) createCustomSnakesAndLadders();
            else           createSnakesAndLadders();
        }
 
        private void createBoard() {
            for (int i = 1; i <= 100; i++) {
                int row = (i - 1) / 10;
                int col = (row % 2 == 0) ? (i - 1) % 10 : 9 - ((i - 1) % 10);
                Cell cell = new Cell(i, row, col);
                grid[row][col] = cell;
            }
        }
 
        private void createSnakesAndLadders() {
            snakes.put(99, 54);
            snakes.put(70, 55);
            snakes.put(52, 42);
            snakes.put(25, 2);
 
            for (Map.Entry<Integer, Integer> e : snakes.entrySet()) {
                getCellByNumber(e.getKey()).type   = CellType.SNAKE_HEAD;
                getCellByNumber(e.getValue()).type = CellType.SNAKE_TAIL;
            }
 
            ladders.put(3, 22);
            ladders.put(15, 44);
            ladders.put(36, 72);
            ladders.put(61, 95);
 
            for (Map.Entry<Integer, Integer> e : ladders.entrySet()) {
                getCellByNumber(e.getKey()).type   = CellType.LADDER_START;
                getCellByNumber(e.getValue()).type = CellType.LADDER_END;
            }
        }
 
        private void createCustomSnakesAndLadders() {
            snakes.put(98, 40);
            snakes.put(85, 60);
            snakes.put(63, 18);
            snakes.put(48, 30);
            snakes.put(33, 8);
 
            for (Map.Entry<Integer, Integer> e : snakes.entrySet()) {
                getCellByNumber(e.getKey()).type   = CellType.SNAKE_HEAD;
                getCellByNumber(e.getValue()).type = CellType.SNAKE_TAIL;
            }
 
            ladders.put(5, 28);
            ladders.put(20, 55);
            ladders.put(41, 79);
            ladders.put(67, 92);
            ladders.put(10, 35);
 
            for (Map.Entry<Integer, Integer> e : ladders.entrySet()) {
                getCellByNumber(e.getKey()).type   = CellType.LADDER_START;
                getCellByNumber(e.getValue()).type = CellType.LADDER_END;
            }
        }
 
        public Cell getCellByNumber(int number) {
            int row = (number - 1) / 10;
            int col = (row % 2 == 0) ? (number - 1) % 10 : 9 - ((number - 1) % 10);
            return grid[row][col];
        }
 
        public boolean isSnake(int pos)  { return snakes.containsKey(pos); }
        public boolean isLadder(int pos) { return ladders.containsKey(pos); }
 
        public int getDestination(int pos) {
            if (isSnake(pos))  return snakes.get(pos);
            if (isLadder(pos)) return ladders.get(pos);
            return pos;
        }
 
        public Point getCoordinate(int tile) {
            int row = (tile - 1) / 10;
            int col = (row % 2 == 0) ? (tile - 1) % 10 : 9 - ((tile - 1) % 10);
            int x = col * 60;
            int y = 600 - ((row + 1) * 60);
            return new Point(x, y);
        }
 
        public Point getCenter(int tile) {
            Point p = getCoordinate(tile);
            return new Point(p.x + 30, p.y + 30);
        }
    }
 
    // ============================================================
    // MODEL: GameState
    // ============================================================
 
    static class GameState {
        List<Player> players  = new ArrayList<>();
        int  currentTurn      = 0;
        int  round            = 1;
        GameStatus status     = GameStatus.RUNNING;
        Player winner         = null;
        List<Move> moveLog    = new ArrayList<>();
 
        public Player getCurrentPlayer() {
            return players.get(currentTurn);
        }
 
        public void nextTurn() {
            currentTurn++;
            if (currentTurn >= players.size()) {
                currentTurn = 0;
                round++;
            }
        }
 
        public void addMove(Move move) {
            moveLog.add(0, move);
            if (moveLog.size() > 100) moveLog.remove(moveLog.size() - 1);
        }
 
        public void reset() {
            for (Player p : players) p.reset();
            currentTurn = 0;
            round       = 1;
            status      = GameStatus.RUNNING;
            winner      = null;
            moveLog.clear();
        }
    }
 
