    public static void playBackgroundMusic(String fileName) {
        stopBackgroundMusic(); // Matikan lagu sebelumnya agar tidak tumpang tindih
        try {
            java.net.URL soundURL = UAP_REVO2.class.getResource("/sound/" + fileName);
            javax.sound.sampled.AudioInputStream audioStream;
            
            if (soundURL != null) {
                audioStream = javax.sound.sampled.AudioSystem.getAudioInputStream(soundURL);
            } else {
                java.io.File soundFile = new java.io.File("sound/" + fileName);
                if (soundFile.exists()) {
                    audioStream = javax.sound.sampled.AudioSystem.getAudioInputStream(soundFile);
                } else {
                    System.out.println("File musik tidak ditemukan: " + fileName);
                    return;
                }
            }
            
            backgroundMusic = javax.sound.sampled.AudioSystem.getClip();
            backgroundMusic.open(audioStream);
            backgroundMusic.loop(javax.sound.sampled.Clip.LOOP_CONTINUOUSLY); // Mengulang terus
            backgroundMusic.start();
        } catch (Exception e) {
            System.out.println("Gagal memutar musik: " + e.getMessage());
        }
    }

    public static void stopBackgroundMusic() {
        if (backgroundMusic != null && backgroundMusic.isRunning()) {
            backgroundMusic.stop();
            backgroundMusic.close();
        }
    }
