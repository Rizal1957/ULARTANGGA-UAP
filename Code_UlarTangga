        private void startGame() {
            int count = (int) spinnerCount.getValue();
            String[] names = new String[count];
            for (int i = 0; i < count; i++) {
                String n = nameFields[i].getText().trim();
                if (n.isEmpty()) {
                    JOptionPane.showMessageDialog(this,
                        "Nama pemain " + (i+1) + " tidak boleh kosong!",
                        "Peringatan", JOptionPane.WARNING_MESSAGE);
                    return;
                }
                names[i] = n;
            }
            // Cek nama duplikat
            for (int i = 0; i < count; i++) {
                for (int j = i + 1; j < count; j++) {
                    if (names[i].equalsIgnoreCase(names[j])) {
                        JOptionPane.showMessageDialog(this,
                            "Nama pemain " + (i+1) + " dan pemain " + (j+1) + " tidak boleh sama!",
                            "Peringatan", JOptionPane.WARNING_MESSAGE);
                        return;
                    }
                }
            }
            showGame(new GameConfig(count, names, chkCustomBoard.isSelected(), chkSound.isSelected()));
        }
 
