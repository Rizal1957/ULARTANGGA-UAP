    static class DicePanel extends JPanel {
        GamePanel gamePanel;
        JButton   btnRoll;
        DiceFace  diceFace;
        javax.swing.Timer animTimer;
        int animCount;
 
        public DicePanel(GamePanel gamePanel) {
            this.gamePanel = gamePanel;
            setBackground(new Color(255, 250, 230));
            setBorder(BorderFactory.createTitledBorder(
                BorderFactory.createLineBorder(new Color(200,200,200)),
                "Dadu", TitledBorder.LEFT, TitledBorder.TOP,
                new Font("Arial", Font.BOLD, 13)));
            setPreferredSize(new Dimension(380, 120));
            setMaximumSize(new Dimension(Integer.MAX_VALUE, 120));
            setLayout(new FlowLayout(FlowLayout.CENTER, 20, 12));
 
            diceFace = new DiceFace(0);
 
            btnRoll = new JButton("Lempar Dadu!");
            btnRoll.setFont(new Font("Arial", Font.BOLD, 15));
            btnRoll.setBackground(new Color(220, 50, 50));
            btnRoll.setForeground(Color.WHITE);
            btnRoll.setFocusPainted(false);
            btnRoll.setBorderPainted(false);
            btnRoll.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
            btnRoll.setPreferredSize(new Dimension(150, 60));
            btnRoll.addActionListener(e -> startRollAnimation());
 
            add(diceFace);
            add(btnRoll);
        }
 
        private void startRollAnimation() {
            btnRoll.setEnabled(false);
            animCount = 0;
            final int realValue = gamePanel.dice.roll();
            animTimer = new javax.swing.Timer(70, e -> {
                if (animCount < 11) {
                    diceFace.setValue(new Random().nextInt(6) + 1);
                } else {
                    diceFace.setValue(realValue);
                    animTimer.stop();
                    gamePanel.playTurn(realValue);
                }
                animCount++;
            });
            animTimer.start();
        }
 
        public void showValue(int val) { diceFace.setValue(val); }
 
        public void setRollEnabled(boolean enabled) { btnRoll.setEnabled(enabled); }
    }
 
    // ============================================================
    // GUI: DiceFace — visual titik dadu
    // ============================================================
 
    static class DiceFace extends JPanel {
        private int value; 
 
        private static final int[][][] DOT_POSITIONS = {
            {},                                                         
            {{1,1}},                                                     
            {{0,0},{2,2}},                                               
            {{0,0},{1,1},{2,2}},                                         
            {{0,0},{0,2},{2,0},{2,2}},                                   
            {{0,0},{0,2},{1,1},{2,0},{2,2}},                             
            {{0,0},{0,2},{1,0},{1,2},{2,0},{2,2}}                        
        };
 
        public DiceFace(int value) {
            this.value = value;
            setPreferredSize(new Dimension(70, 70));
            setOpaque(false);
        }
 
        public void setValue(int v) {
            this.value = v;
            repaint();
        }
 
        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
 
            int size = 64;
            int x0 = (getWidth()  - size) / 2;
            int y0 = (getHeight() - size) / 2;
            int arc = 12;
 
            // Badan dadu
            g2.setColor(Color.WHITE);
            g2.fillRoundRect(x0, y0, size, size, arc, arc);
            g2.setColor(new Color(180, 50, 50));
            g2.setStroke(new BasicStroke(2.5f));
            g2.drawRoundRect(x0, y0, size, size, arc, arc);
 
            if (value == 0) {
                g2.setColor(new Color(180, 50, 50));
                g2.setFont(new Font("Arial", Font.BOLD, 28));
                FontMetrics fm = g2.getFontMetrics();
                g2.drawString("?", x0 + (size - fm.stringWidth("?")) / 2,
                              y0 + (size + fm.getAscent()) / 2 - 4);
                return;
            }
 
            // Gambar titik-titik
            int dotR   = 6;
            int margin = 12;
            int step   = (size - 2 * margin - dotR * 2) / 2;
 
            g2.setColor(new Color(180, 30, 30));
            for (int[] pos : DOT_POSITIONS[value]) {
                int col = pos[0]; 
                int row = pos[1]; 
                int cx = x0 + margin + dotR + col * step;
                int cy = y0 + margin + dotR + row * step;
                g2.fillOval(cx - dotR, cy - dotR, dotR * 2, dotR * 2);
            }
        }
    }
 
