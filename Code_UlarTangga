        private void playSound(String fileName) {
        // JIKA CHECKBOX TIDAK DICENTANG, JANGAN PUTAR SUARA
        if (chkSound != null && !chkSound.isSelected()) {
            return; 
        }

        try {
            java.net.URL soundURL = getClass().getResource("/sound/" + fileName);
            javax.sound.sampled.AudioInputStream audioStream;
            
            if (soundURL != null) {
                audioStream = javax.sound.sampled.AudioSystem.getAudioInputStream(soundURL);
            } else {
                java.io.File soundFile = new java.io.File("sound/" + fileName);
                if (soundFile.exists()) {
                    audioStream = javax.sound.sampled.AudioSystem.getAudioInputStream(soundFile);
                } else {
                    System.out.println("File suara tidak ditemukan: " + fileName);
                    return;
                }
            }
            
            javax.sound.sampled.Clip clip = javax.sound.sampled.AudioSystem.getClip();
            clip.open(audioStream);
            clip.start();
        } catch (Exception e) {
            System.out.println("Gagal memutar suara: " + e.getMessage());
        }
    }
        
    

