        // Dipanggil DicePanel saat tombol diklik, menerima hasil dadu dari animasi
        public void playTurn(int diceValue) {
            if (animationRunning) return;
            if (gameState.status == GameStatus.FINISHED) return;
 
            Player player = gameState.getCurrentPlayer();
            int oldPos    = player.position;
 
            player.turnCount++;
 
            // Belum masuk papan — harus dapat 6
            if (oldPos == 0) {
                if (diceValue == 6) {
                    player.position = 1;
                    Move move = new Move(player, diceValue, 0, 1, 1, EffectType.NONE,
                        player.name + " melempar " + diceValue + " -> masuk ke petak 1!");
                    gameState.addMove(move);
                    // Dapat 6 boleh lempar lagi, aktifkan tombol kembali
                    refresh();
                    dicePanel.setRollEnabled(true); // FIX: tombol aktif kembali
                } else {
                    Move move = new Move(player, diceValue, 0, 0, 0, EffectType.NONE,
                        player.name + " melempar " + diceValue + " -> belum dapat angka 6");
                    gameState.addMove(move);
                    gameState.nextTurn();
                    refresh();
                    dicePanel.setRollEnabled(true); // FIX: tombol aktif kembali
                }
                return;
            }
 
            // Sudah di papan — hitung posisi baru
            int targetPos = oldPos + diceValue;
            if (targetPos > 100) targetPos = 100 - (targetPos - 100);
 
            final int finalTarget = targetPos;
 
            // Animasi pion bergerak petak per petak
            animationRunning = true;
            dicePanel.setRollEnabled(false);
 
            javax.swing.Timer timer = new javax.swing.Timer(120, null);
            timer.addActionListener(e -> {
                if (player.position < finalTarget) {
                    player.position++;
                    boardPanel.repaint();
                } else {
                    timer.stop();
                    animationRunning = false;
 
                    EffectType effect = EffectType.NONE;
                    String desc;
 
                    if (board.isSnake(finalTarget)) {
                        int dest = board.getDestination(finalTarget);
                        desc = player.name + " melempar " + diceValue
                             + " -> kena ular! " + finalTarget + " -> " + dest;
                        player.position = dest;
                        player.snakeHits++;
                        effect = EffectType.SNAKE;
                    } else if (board.isLadder(finalTarget)) {
                        int dest = board.getDestination(finalTarget);
                        desc = player.name + " melempar " + diceValue
                             + " -> naik tangga! " + finalTarget + " -> " + dest;
                        player.position = dest;
                        player.ladderClimbs++;
                        effect = EffectType.LADDER;
                    } else {
                        desc = player.name + " melempar " + diceValue
                             + " -> maju ke petak " + finalTarget;
                    }
 
                    Move move = new Move(player, diceValue, oldPos,
                                        finalTarget, player.position, effect, desc);
                    gameState.addMove(move);
 
                    // Cek menang
                    if (player.position == 100) {
                        player.winner      = true;
                        gameState.winner   = player;
                        gameState.status   = GameStatus.FINISHED;
                        refresh();
                        dicePanel.setRollEnabled(true); 
                        
                        new javax.swing.Timer(500, ev -> {
                            ((javax.swing.Timer)ev.getSource()).stop();
                            showWin(gameState, config);
                        }).start();
                        return;
                    }
 
                    if (diceValue != 6) {
                        gameState.nextTurn();
                    }
 
                    refresh();
                    dicePanel.setRollEnabled(true);
                }
            });
            timer.start();
        }
 
        public void refresh() {
            infoPanel.refresh();
            statsPanel.refresh();
            logPanel.refresh();
            boardPanel.repaint();
        }
    }
 
