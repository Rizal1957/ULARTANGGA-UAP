            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING,
                                RenderingHints.VALUE_ANTIALIAS_ON);
            drawCells(g2);
            drawLadders(g2);
            drawSnakes(g2);
            drawPlayers(g2);
        }
 
        private void drawCells(Graphics2D g2) {
            for (int row = 0; row < 10; row++) {
                for (int col = 0; col < 10; col++) {
                    int number = (row % 2 == 0)
                        ? row * 10 + col + 1
                        : row * 10 + (10 - col);
                    int x = col * CELL;
                    int y = 600 - ((row + 1) * CELL);
 
                    // Warna petak
                    Color bg;
                    if (board.isSnake(number))        bg = new Color(255, 160, 160);
                    else if (board.isLadder(number))  bg = new Color(160, 230, 160);
                    else if (number == 100)            bg = new Color(255, 215, 0);
                    else bg = (number % 2 == 0) ? new Color(255, 255, 220) : Color.WHITE;
 
                    g2.setColor(bg);
                    g2.fillRect(x, y, CELL, CELL);
 
                    // Border
                    g2.setColor(new Color(180, 180, 180));
                    g2.drawRect(x, y, CELL, CELL);
 
                    // Nomor
                    g2.setColor(Color.DARK_GRAY);
                    g2.setFont(new Font("Arial", Font.BOLD, 10));
                    g2.drawString(String.valueOf(number), x + 3, y + 13);
 
                    // Label ular/tangga kecil
                    if (board.isSnake(number)) {
                        g2.setColor(new Color(180, 0, 0));
                        g2.setFont(new Font("Arial", Font.PLAIN, 9));
                        g2.drawString("->"+board.snakes.get(number), x + 3, y + CELL - 5);
                    } else if (board.isLadder(number)) {
                        g2.setColor(new Color(0, 120, 0));
                        g2.setFont(new Font("Arial", Font.PLAIN, 9));
                        g2.drawString("->"+board.ladders.get(number), x + 3, y + CELL - 5);
                    }
                }
            }
        }
 
        private void drawLadders(Graphics2D g2) {
            g2.setStroke(new BasicStroke(4f));
            for (Map.Entry<Integer, Integer> e : board.ladders.entrySet()) {
                Point pBot = board.getCenter(e.getKey());
                Point pTop = board.getCenter(e.getValue());
                int offset = 5;
 
                g2.setColor(new Color(0, 150, 0));
                g2.drawLine(pBot.x - offset, pBot.y, pTop.x - offset, pTop.y);
                g2.drawLine(pBot.x + offset, pBot.y, pTop.x + offset, pTop.y);
 
                g2.setStroke(new BasicStroke(2f));
                g2.setColor(new Color(0, 200, 0));
                for (int i = 0; i <= 4; i++) {
                    float t  = (float) i / 4;
                    int rx = (int)(pBot.x + t * (pTop.x - pBot.x));
                    int ry = (int)(pBot.y + t * (pTop.y - pBot.y));
                    g2.drawLine(rx - offset, ry, rx + offset, ry);
                }
                g2.setStroke(new BasicStroke(4f));
            }
            g2.setStroke(new BasicStroke(1f));
        }
 
        private void drawSnakes(Graphics2D g2) {
            g2.setStroke(new BasicStroke(5f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
            for (Map.Entry<Integer, Integer> e : board.snakes.entrySet()) {
                Point pHead = board.getCenter(e.getKey());
                Point pTail = board.getCenter(e.getValue());
                int cx = (pHead.x + pTail.x) / 2 + 25;
                int cy = (pHead.y + pTail.y) / 2 - 25;
 
                g2.setColor(new Color(200, 0, 0));
                g2.draw(new QuadCurve2D.Float(pHead.x, pHead.y, cx, cy, pTail.x, pTail.y));
 
                // Kepala ular
                g2.setColor(new Color(140, 0, 0));
                g2.fillOval(pHead.x - 7, pHead.y - 7, 14, 14);
            }
            g2.setStroke(new BasicStroke(1f));
        }
 
        private void drawPlayers(Graphics2D g2) {

            int[][] offsets = {
                {0,0},{-10,-10},{10,-10},{-10,10},{10,10},
                {0,-14},{0,14},{-14,0},{14,0},{-7,-14},{7,-14},{0,18}
            };
 
            // Hitung berapa pemain di tiap posisi
            Map<Integer, List<Player>> posMap = new LinkedHashMap<>();
            for (Player p : gameState.players) {
                posMap.computeIfAbsent(p.position, k -> new ArrayList<>()).add(p);
            }
 
            for (Map.Entry<Integer, List<Player>> entry : posMap.entrySet()) {
                int pos = entry.getKey();
                List<Player> here = entry.getValue();
 
                if (pos == 0) {

                    for (int i = 0; i < here.size(); i++) {
                        drawPion(g2, 10 + i * 22, 585, here.get(i));
                    }
                } else {
                    Point center = board.getCenter(pos);
                    for (int i = 0; i < here.size(); i++) {
                        int ox = (here.size() > 1 && i < offsets.length) ? offsets[i][0] : 0;
                        int oy = (here.size() > 1 && i < offsets.length) ? offsets[i][1] : 0;
                        drawPion(g2, center.x + ox, center.y + oy, here.get(i));
                    }
                }
            }
        }
 
        private void drawPion(Graphics2D g2, int x, int y, Player p) {
            int r = 10;
            // Bayangan
            g2.setColor(new Color(0,0,0,50));
            g2.fillOval(x - r + 2, y - r + 2, r*2, r*2);
            // Badan
            g2.setColor(p.color);
            g2.fillOval(x - r, y - r, r*2, r*2);
            // Border
            g2.setColor(p.color.darker());
            g2.setStroke(new BasicStroke(2f));
            g2.drawOval(x - r, y - r, r*2, r*2);
            g2.setStroke(new BasicStroke(1f));
            // Highlight
            g2.setColor(new Color(255,255,255,100));
            g2.fillOval(x - r + 2, y - r + 2, r - 2, r - 2);
            // Inisial
            g2.setColor(Color.WHITE);
            g2.setFont(new Font("Arial", Font.BOLD, 9));
            String ini = String.valueOf(p.name.charAt(0)).toUpperCase();
            FontMetrics fm = g2.getFontMetrics();
            g2.drawString(ini, x - fm.stringWidth(ini)/2, y + fm.getAscent()/2 - 1);
        }
    }
 
